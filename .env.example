# 복사해서 .env로 쓴다. .env는 commit하지 않는다.
# secret은 여기에 실제 값을 두지 않는다 — 이름만 남긴다.

# local | staging | production
APP_ENV=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Cloud Run에서는 platform이 주입한다. 로컬 기본값.
PORT=8080

# Apple identity token의 expected audience.
# native iOS Sign in with Apple에서는 app의 Bundle ID다 (Services ID가 아니다).
# APP_ENV=production이면 필수 — 없으면 기동에서 실패한다.
APPLE_CLIENT_ID=com.mark77234.ggumirror

# Firestore. Cloud Run에서는 Application Default Credentials를 쓴다.
# service account JSON key를 repo에 두지 않는다.
# APP_ENV=production이면 GCP_PROJECT_ID 필수.
GCP_PROJECT_ID=
FIRESTORE_DATABASE=(default)

# SSV callback의 `ad_unit` / `reward_item`과 **글자 그대로 비교할 기대값**이다.
# 지급액의 출처가 아니라 검증 대상이다.
#
# client가 광고 load에 쓰는 ad unit ID(xcconfig의 ADMOB_REWARDED_AD_UNIT_ID)와
# **같다고 가정하지 않는다.** callback의 `ad_unit` 실제 표현은 SSV Test Tool을
# 한 번 돌려 확인한 뒤 그 값을 그대로 넣는다.
#
# 비어 있으면 서명 검증을 통과해도 지급하지 않는다(fail closed). 추측한 값을 넣지 않는다.
ADMOB_SSV_EXPECTED_AD_UNIT=
ADMOB_REWARD_ITEM=
